import { getUser } from '@netlify/identity'
import { getDatabase } from '@netlify/database'
import { getStore } from '@netlify/blobs'
import { eq, and, or, desc, gt } from 'drizzle-orm'
import { db } from '../../db/index'
import * as s from '../../db/schema'
const types=['Part time - Remote','Remote - full time','On site - full time','On site - part time','Internship','Any']
const id=()=>crypto.randomUUID()
function check(ok:unknown,message:string,status=400):asserts ok {if(!ok) throw Object.assign(new Error(message),{status})}
const str=(v:unknown,max=200)=>{check(typeof v==='string'&&v.trim().length>0&&v.length<=max,'Please complete all required fields.');return v.trim()}
async function seed(){for(const role of ['employer','applicant']) for(const [i,name] of ['Free','Basic','Pro','Premium','Ultimate'].entries()) await db.insert(s.plans).values({id:`${role}-${name}`,role,name,price:(role==='employer'?[0,79,149,299,499]:[0,49,99,199,299])[i],limit:[role==='employer'?2:10,10,30,75,200][i],features:role==='employer'?'Monthly job posts · Applicant management · Private chats':'Monthly applications · Saved jobs · Direct employer chats'}).onConflictDoNothing()}
export default async(req:Request)=>{try{
 const url=new URL(req.url), action=url.pathname.replace('/api/',''), method=req.method
 if(method!=='GET'){check(req.headers.get('origin')===url.origin,'Invalid request origin',403)}
 if(action==='content'&&method==='GET'){const rows=await db.select().from(s.content);return Response.json(Object.fromEntries(rows.map(r=>[r.id,r.data])))}
 if(action==='plans'){await seed();return Response.json(await db.select().from(s.plans))}
 if(action==='jobs'&&method==='GET') return Response.json(await db.select().from(s.jobs).where(eq(s.jobs.status,'published')).orderBy(desc(s.jobs.createdAt)))
 const auth=await getUser();check(auth,'Please log in to continue.',401)
 let [me]=await db.select().from(s.users).where(eq(s.users.id,auth.id))
 check(method==='GET'||method==='POST','Method not allowed',405);if(!['me','profile','jobs','chats','dashboard','resume-download','admin'].includes(action))check(method==='POST','Method not allowed',405);
 const b=method==='GET'?{}:req.headers.get('content-type')?.includes('application/json')?await req.json():{}
 if(action==='profile'&&method==='POST'&&!me){const meta=auth.userMetadata||{};check(/^[+0-9 ()-]{7,20}$/.test(String(meta.phone||'')),'Enter a valid phone number');check(['applicant','employer'].includes(String(meta.account_type)),'Choose your account type.');[me]=await db.insert(s.users).values({id:auth.id,email:auth.email||'',name:str(meta.full_name),phone:str(meta.phone,30),gst:String(meta.gst||''),role:String(meta.account_type)}).onConflictDoNothing().returning();if(!me)[me]=await db.select().from(s.users).where(eq(s.users.id,auth.id))}
 check(me,'Complete registration first.',403);check(!me.disabled,'This account is suspended.',403)
 const admin=!!auth.roles?.includes('admin')
 const role=(r:string)=>check(me.role===r,`An ${r} account is required.`,403)
 if(action==='me')return Response.json({...me,admin})
 if(action==='profile'&&method==='POST'){if(b.bio!==undefined)check(typeof b.bio==='string'&&b.bio.length<=2000,'Bio must be at most 2,000 characters.');if(b.phone!==undefined)check(typeof b.phone==='string'&&/^[+0-9 ()-]{7,20}$/.test(b.phone),'Enter a valid phone number');await db.update(s.users).set({name:b.name?str(b.name):me.name,phone:b.phone?str(b.phone,30):me.phone,bio:b.bio!==undefined?b.bio.trim():me.bio,gst:b.gst!==undefined?String(b.gst).slice(0,15):me.gst,experience:String(b.experience??me.experience).slice(0,200),skills:String(b.skills??me.skills).slice(0,1000),preference:String(b.preference??me.preference).slice(0,200),workType:types.includes(b.workType)?b.workType:me.workType}).where(eq(s.users.id,me.id));return Response.json({ok:true})}
 if(action==='jobs'&&method==='POST'){role('employer');const title=str(b.title),salary=Number(b.salary),openings=Number(b.openings);check(Number.isInteger(salary)&&salary>0&&Number.isInteger(openings)&&openings>0&&openings<=10000&&types.includes(b.workType),'Enter a positive salary, openings, and valid work type.');
 const client=await getDatabase().pool.connect();try{await client.query('BEGIN');await client.query('SELECT id FROM users WHERE id=$1 FOR UPDATE',[me.id]);const existing=await client.query('SELECT * FROM jobs WHERE request_key=$1',[str(b.requestKey)]);if(existing.rows.length){await client.query('COMMIT');return Response.json(existing.rows[0])}
 const plan=await client.query("SELECT p.\"limit\" FROM subscriptions x JOIN plans p ON p.id=x.plan_id WHERE x.user_id=$1 AND x.expires_at>now() ORDER BY x.expires_at DESC LIMIT 1",[me.id]);const count=await client.query("SELECT count(*) FROM jobs WHERE employer_id=$1 AND created_at>=date_trunc('month',now())",[me.id]);check(Number(count.rows[0].count)<(plan.rows[0]?.limit??2),'Monthly job posting limit reached. Choose a plan.');const job=await client.query('INSERT INTO jobs(id,employer_id,company,title,salary,work_type,openings,request_key) VALUES($1,$2,$3,$4,$5,$6,$7,$8) RETURNING *',[id(),me.id,me.name,title,salary,b.workType,openings,b.requestKey]);await client.query('COMMIT');return Response.json(job.rows[0])}catch(e){await client.query('ROLLBACK');throw e}finally{client.release()}}
 if(action==='job-update'){role('employer');const [job]=await db.select().from(s.jobs).where(and(eq(s.jobs.id,b.id),eq(s.jobs.employerId,me.id)));check(job,'Job not found',404);check(['published','closed'].includes(b.status),'Invalid status');const patch:any={status:b.status};if(b.title){patch.title=str(b.title);patch.salary=Number(b.salary);patch.openings=Number(b.openings);check(Number.isInteger(patch.salary)&&patch.salary>0&&Number.isInteger(patch.openings)&&patch.openings>0&&types.includes(b.workType),'Invalid job values');patch.workType=b.workType}await db.update(s.jobs).set(patch).where(eq(s.jobs.id,job.id));return Response.json({ok:true})}
 if(action==='apply'){role('applicant');const client=await getDatabase().pool.connect();try{await client.query('BEGIN');await client.query('SELECT id FROM users WHERE id=$1 FOR UPDATE',[me.id]);const old=await client.query('SELECT c.id FROM conversations c JOIN applications a ON a.id=c.application_id WHERE a.job_id=$1 AND a.applicant_id=$2',[b.jobId,me.id]);if(old.rows.length){await client.query('COMMIT');return Response.json(old.rows[0])}const job=await client.query("SELECT * FROM jobs WHERE id=$1 AND status='published' FOR UPDATE",[b.jobId]);check(job.rows[0],'This job is closed.',409);const limits=await client.query('SELECT p."limit" FROM subscriptions x JOIN plans p ON p.id=x.plan_id WHERE x.user_id=$1 AND x.expires_at>now() ORDER BY x.expires_at DESC LIMIT 1',[me.id]);const usage=await client.query("SELECT count(*) FROM applications WHERE applicant_id=$1 AND created_at>=date_trunc('month',now())",[me.id]);check(Number(usage.rows[0].count)<(limits.rows[0]?.limit??10),'Monthly application limit reached.');const aid=id(),cid=id(),employer=job.rows[0].employer_id;await client.query('INSERT INTO applications(id,job_id,applicant_id,employer_id) VALUES($1,$2,$3,$4)',[aid,b.jobId,me.id,employer]);await client.query('INSERT INTO conversations(id,application_id,applicant_id,employer_id) VALUES($1,$2,$3,$4)',[cid,aid,me.id,employer]);await client.query('INSERT INTO messages(id,conversation_id,sender_id,body) VALUES($1,$2,$3,$4)',[id(),cid,me.id,`Hello I Am ${me.name}, I Am Interested, Can I Get More Info?`]);await client.query('INSERT INTO notifications(id,user_id,body) VALUES($1,$2,$3)',[id(),employer,`${me.name} applied for ${job.rows[0].title}`]);await client.query('COMMIT');return Response.json({id:cid})}catch(e){await client.query('ROLLBACK');throw e}finally{client.release()}}
 if(action==='chats'){const cs=await db.select().from(s.conversations).where(or(eq(s.conversations.applicantId,me.id),eq(s.conversations.employerId,me.id)));const result=[];for(const c of cs){const [other]=await db.select({name:s.users.name}).from(s.users).where(eq(s.users.id,c.applicantId===me.id?c.employerId:c.applicantId));const ms=await db.select().from(s.messages).where(eq(s.messages.conversationId,c.id)).orderBy(s.messages.createdAt);result.push({...c,name:other?.name,messages:ms})}return Response.json(result)}
 if(action==='message'||action==='read'){const [c]=await db.select().from(s.conversations).where(and(eq(s.conversations.id,b.conversationId),or(eq(s.conversations.applicantId,me.id),eq(s.conversations.employerId,me.id))));check(c,'Conversation not found',404);if(action==='message'){await db.insert(s.messages).values({id:id(),conversationId:c.id,senderId:me.id,body:str(b.body,4000)});await db.insert(s.notifications).values({id:id(),userId:c.applicantId===me.id?c.employerId:c.applicantId,body:`New message from ${me.name}`})}else{const other=c.applicantId===me.id?c.employerId:c.applicantId;await db.update(s.messages).set({read:true}).where(and(eq(s.messages.conversationId,c.id),eq(s.messages.senderId,other)))}return Response.json({ok:true})}
 if(action==='save'){role('applicant');check((await db.select().from(s.jobs).where(eq(s.jobs.id,b.jobId)))[0],'Job not found');if(b.remove)await db.delete(s.savedJobs).where(and(eq(s.savedJobs.userId,me.id),eq(s.savedJobs.jobId,b.jobId)));else await db.insert(s.savedJobs).values({id:id(),userId:me.id,jobId:b.jobId}).onConflictDoNothing();return Response.json({ok:true})}
 if(action==='status'){role('employer');check(['shortlisted','rejected','hired'].includes(b.status),'Invalid status');const [a]=await db.update(s.applications).set({status:b.status}).where(and(eq(s.applications.id,b.id),eq(s.applications.employerId,me.id))).returning();check(a,'Application not found');await db.insert(s.notifications).values({id:id(),userId:a.applicantId,body:`Your application was ${b.status}.`});return Response.json({ok:true})}
 if(action==='dashboard'){const apps=await db.select({application:s.applications,job:s.jobs,applicant:{id:s.users.id,name:s.users.name,experience:s.users.experience,skills:s.users.skills,resume:s.users.resume}}).from(s.applications).innerJoin(s.jobs,eq(s.jobs.id,s.applications.jobId)).innerJoin(s.users,eq(s.users.id,s.applications.applicantId)).where(me.role==='employer'?eq(s.applications.employerId,me.id):eq(s.applications.applicantId,me.id));return Response.json({applications:apps,jobs:await db.select().from(s.jobs).where(eq(s.jobs.employerId,me.id)),saved:await db.select().from(s.savedJobs).innerJoin(s.jobs,eq(s.jobs.id,s.savedJobs.jobId)).where(eq(s.savedJobs.userId,me.id)),notifications:await db.select().from(s.notifications).where(eq(s.notifications.userId,me.id)).orderBy(desc(s.notifications.createdAt)),subscriptions:await db.select().from(s.subscriptions).where(and(eq(s.subscriptions.userId,me.id),gt(s.subscriptions.expiresAt,new Date()))),payments:await db.select().from(s.payments).where(eq(s.payments.userId,me.id))})}
 if(action==='checkout'){await seed();const [plan]=await db.select().from(s.plans).where(and(eq(s.plans.id,b.planId),eq(s.plans.role,me.role)));check(plan,'Invalid plan');check(['success','failure'].includes(b.outcome),'Select a sandbox outcome');await db.insert(s.payments).values({id:id(),userId:me.id,planId:plan.id,amount:plan.price,status:b.outcome,sandbox:true});if(b.outcome==='success'){await db.delete(s.subscriptions).where(eq(s.subscriptions.userId,me.id));await db.insert(s.subscriptions).values({id:id(),userId:me.id,planId:plan.id,expiresAt:new Date(Date.now()+30*86400000),sandbox:true})}return Response.json({ok:b.outcome==='success',message:b.outcome==='success'?'Sandbox plan activated for 30 days. No real money was charged.':'Sandbox payment failed. Your plan is unchanged.'})}
 if(action==='cancel'){await db.update(s.subscriptions).set({cancelled:true}).where(eq(s.subscriptions.userId,me.id));return Response.json({ok:true})}
 if(action==='resume'){role('applicant');const form=await req.formData(),file=form.get('file');check(file instanceof File&&file.type==='application/pdf'&&file.size<=3*1024*1024,'Upload a PDF up to 3 MB');const buffer=await file.arrayBuffer();check(new TextDecoder().decode(buffer.slice(0,5))==='%PDF-','Invalid PDF');const key=`resumes/${me.id}/${id()}.pdf`;await getStore('private-resumes').set(key,buffer);await db.update(s.users).set({resume:key}).where(eq(s.users.id,me.id));return Response.json({ok:true})}
 if(action==='resume-download'){const target=url.searchParams.get('user');check(target,'Missing user');if(target!==me.id&&!admin){role('employer');check((await db.select().from(s.applications).where(and(eq(s.applications.applicantId,target),eq(s.applications.employerId,me.id))))[0],'Access denied',403)}const [p]=await db.select().from(s.users).where(eq(s.users.id,target));check(p?.resume,'Resume not found',404);const file=await getStore('private-resumes').get(p.resume,{type:'arrayBuffer'});check(file,'Resume not found',404);return new Response(file,{headers:{'Content-Type':'application/pdf','Content-Disposition':'attachment; filename="resume.pdf"','Cache-Control':'private, no-store'}})}
 if(action==='report'){await db.insert(s.reports).values({id:id(),userId:me.id,body:str(b.body,4000)});return Response.json({ok:true})}
 if(action==='admin'){check(admin,'Admin access required',403);if(method==='GET')return Response.json({users:await db.select().from(s.users),jobs:await db.select().from(s.jobs),reports:await db.select().from(s.reports),plans:await db.select().from(s.plans),payments:await db.select().from(s.payments),subscriptions:await db.select().from(s.subscriptions),content:await db.select().from(s.content)});if(b.kind==='user')await db.update(s.users).set({disabled:!!b.disabled}).where(eq(s.users.id,b.id));if(b.kind==='job')await db.update(s.jobs).set({status:b.status==='published'?'published':'closed'}).where(eq(s.jobs.id,b.id));if(b.kind==='report')await db.update(s.reports).set({status:'resolved'}).where(eq(s.reports.id,b.id));if(b.kind==='plan'){check(Number.isInteger(b.price)&&b.price>=0&&Number.isInteger(b.limit)&&b.limit>0,'Invalid plan');await db.update(s.plans).set({price:b.price,limit:b.limit,features:str(b.features,1000)}).where(eq(s.plans.id,b.id))}if(b.kind==='content')await db.insert(s.content).values({id:str(b.id),data:b.data}).onConflictDoUpdate({target:s.content.id,set:{data:b.data}});return Response.json({ok:true})}
 return Response.json({error:'Not found'},{status:404})
 }catch(e:any){return Response.json({error:e.status?e.message:'The request could not be completed. Please try again.'},{status:e.status||500})}}
export const config={path:'/api/*'}
